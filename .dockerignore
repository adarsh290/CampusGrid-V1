# Ignore git files
.git
.gitignore

# Ignore node_modules, as they will be installed within the container
node_modules

# Ignore local environment files
.env
.env.*

# Ignore docker files
.dockerignore
Dockerfile
Dockerfile.backend
Dockerfile.frontend
docker-compose.yml

# Ignore development logs
npm-debug.log
yarn-debug.log
yarn-error.log

# Ignore IDE and OS-specific files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store

# Ignore build output
dist
build
